# Firebase web config (public client values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=mealmate-d2e53
VITE_FIREBASE_FIRESTORE_DATABASE_ID=default
VITE_FIREBASE_STORAGE_BUCKET=

# Firebase Admin identity (server-only; set only as an encrypted Vercel variable)
FIREBASE_PROJECT_ID=mealmate-d2e53
FIREBASE_FIRESTORE_DATABASE_ID=default
FIREBASE_SERVICE_ACCOUNT_JSON=

# AI text, image, and speech use Vercel AI Gateway OIDC on Vercel deployments.
# Enable OIDC for the Vercel project; no provider API key is needed there.
# For local development, set AI_GATEWAY_API_KEY, or use an existing Lovable key.
# When LOVABLE_API_KEY is set, the existing Lovable Gateway is used.
AI_GATEWAY_API_KEY=
LOVABLE_API_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
LOVABLE_DB_MIGRATION_URL=

# Food Photo Providers (optional)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
BING_IMAGE_SEARCH_KEY=

# Premium purchases: public SDK keys are different for each platform.
VITE_REVENUECAT_WEB_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=
VITE_REVENUECAT_IOS_API_KEY=

# RevenueCat verification and webhook secrets: SERVER ONLY, never VITE_ prefixed.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PREMIUM_ENTITLEMENT_ID=premium
# Exact product identifiers, comma-separated; no substring inference.
REVENUECAT_FAMILY_PRODUCT_IDS=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_WEBHOOK_SECRET=

# Public recipe photo storage: connect a Vercel Blob store to this project.
# Vercel supplies these automatically. Keep the token server-only.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Only true in an isolated sandbox deployment; never production.
REVENUECAT_ALLOW_SANDBOX=false
# Verified Firebase UIDs, comma-separated. Never client-supplied emails.
MEALMATE_ADMIN_UIDS=
