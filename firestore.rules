rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{testId} {
      allow get: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // User favorites subcollection
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId) && isValidId(favoriteId);
      }

      // User pantry items subcollection
      match /pantry/{pantryId} {
        allow read, write: if isOwner(userId) && isValidId(pantryId);
      }
    }
  }
}
